// IU Quartz: one SLURM job per task (test run)
process {
    executor       = 'slurm'
    queue          = 'general'
    clusterOptions = '-A r01340'
    resourceLimits = [ cpus: 4, memory: 16.GB, time: 4.h ]   // per-task ceiling
}
executor {
    queueSize       = 10
    submitRateLimit = '10/1min'
    pollInterval    = '30 sec'
}
singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = '/N/scratch/schapag/apptainer_cache/nxf'
}
