// IU Quartz: one SLURM job per task (full run, ~7,500 tasks)
// No beforeScript: module loads there make every task exit under set -e; the head job's PATH is inherited.
// No errorStrategy: ampliseq's own retry-with-more-memory is kept.
process {
    executor       = 'slurm'
    queue          = 'general'
    clusterOptions = '-A r01340'
    resourceLimits = [ cpus: 16, memory: 96.GB, time: 24.h ]
}
executor {
    queueSize       = 50
    submitRateLimit = '30/1min'
    pollInterval    = '30 sec'
}
singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = '/N/scratch/schapag/apptainer_cache/nxf'
}
