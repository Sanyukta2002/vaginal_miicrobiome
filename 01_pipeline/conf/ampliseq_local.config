// Run all ampliseq tasks inside the single SLURM job that launches Nextflow
process {
    executor       = 'local'
    resourceLimits = [ cpus: 16, memory: 64.GB, time: 8.h ]
    // retry twice (ampliseq scales memory on retry), then stop cleanly.
    // NOT 'ignore' - a silently dropped DADA2 task would lose a whole run.
    errorStrategy  = { task.attempt <= 2 ? 'retry' : 'finish' }
    maxRetries     = 2
}
executor {
    name   = 'local'
    cpus   = 16
    memory = '64 GB'
}
singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = '/N/scratch/schapag/apptainer_cache/nxf'
}
