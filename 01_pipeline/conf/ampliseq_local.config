// All ampliseq tasks inside one SLURM job (pilot and truncation runs)
process {
    executor       = 'local'
    resourceLimits = [ cpus: 16, memory: 64.GB, time: 8.h ]
    errorStrategy  = { task.attempt <= 2 ? 'retry' : 'finish' }   // never 'ignore': a dropped DADA2 task loses a whole run
    maxRetries     = 2
}
executor {
    name   = 'local'
    cpus   = 16
    memory = '64 GB'
}
singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = '/N/scratch/schapag/apptainer_cache/nxf'
}
