// All fetchngs tasks inside one SLURM job
process {
    executor       = 'local'
    resourceLimits = [ cpus: 8, memory: 32.GB, time: 48.h ]
    errorStrategy  = { task.attempt <= 3 ? 'retry' : 'ignore' }
    maxRetries     = 3
}
executor {
    name   = 'local'
    cpus   = 8
    memory = '32 GB'
}
singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = '/N/scratch/schapag/apptainer_cache/nxf'
}
