// IU Quartz profile for Project A
process {
    executor       = 'slurm'
    queue          = 'general'
    clusterOptions = '-A r01340'
    // Per-job ceiling (not total). Requests above this are trimmed down.
    resourceLimits = [ cpus: 4, memory: 16.GB, time: 4.h ]
}

executor {
    queueSize       = 10        // max jobs queued/running at once (total)
    submitRateLimit = '10/1min'
    pollInterval    = '30 sec'
}

singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = '/N/scratch/schapag/apptainer_cache/nxf'
}
