// IU Quartz - full ampliseq run. Per-task SLURM submission.
process {
    executor       = 'slurm'
    queue          = 'general'
    clusterOptions = '-A r01340'
    // NO beforeScript. Slurm's --export=ALL propagates the head job's PATH, which
    // is how conf/quartz.config ran 125 tasks successfully at Step 0. Adding
    // 'source /etc/profile; module load ...' here made every task exit 1 in 2s:
    // Lmod returns non-zero in a non-interactive sh and .command.run runs under
    // set -e. Cost the 2026-09-25 overnight run (job 10612145). Do not re-add.
    resourceLimits = [ cpus: 16, memory: 96.GB, time: 24.h ]
    // errorStrategy deliberately NOT set: ampliseq's base config already
    // retries on OOM/signal exit codes (130-145, 104) with memory scaling and
    // uses 'finish' otherwise. That is what recovered the two exit-137 QIIME
    // tasks in the Step 0 test. A blanket override would be strictly worse.
}
executor {
    queueSize       = 50          // ~7,500 tasks; 20 would add hours of pure queue latency
    submitRateLimit = '30/1min'
    pollInterval    = '30 sec'
}
singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = '/N/scratch/schapag/apptainer_cache/nxf'
}
